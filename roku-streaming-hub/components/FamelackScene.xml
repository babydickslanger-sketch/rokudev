<?xml version="1.0" encoding="utf-8" ?>
<component name="FamelackScene" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/FamelackScene.brs" />
    
    <interface>
        <field id="backendIp" type="string" />
        <field id="sceneClosed" type="boolean" alwaysNotify="true" />
    </interface>
    
    <children>
        <!-- Background -->
        <Rectangle 
            id="background" 
            width="1920" 
            height="1080" 
            color="0x000000" />
        
        <!-- Header -->
        <Label 
            id="appTitle" 
            text="Famelack Live" 
            font="font:LargeBoldSystemFont" 
            color="0xFFFFFF" 
            translation="[80, 50]" />
        
        <!-- Tab Buttons -->
        <RowList 
            id="tabList" 
            itemSize="[300, 80]" 
            itemComponentName="FamelackTabItem" 
            numRows="1" 
            translation="[80, 120]" 
            numColumns="3" />
        
        <!-- Content Grid -->
        <PosterGrid 
            id="mediaGrid" 
            basePosterSize="[300, 200]" 
            itemSpacing="[20, 20]" 
            translation="[80, 220]" 
            visible="false" />
        
        <!-- Video Player -->
        <Video 
            id="videoPlayer" 
            visible="false" 
            width="1280" 
            height="720" 
            translation="[320, 180]" />
        
        <!-- Loading Indicator -->
        <Label 
            id="loadingLabel" 
            text="Loading..." 
            font="font:MediumSystemFont" 
            color="0xFFFFFF" 
            translation="[960, 540]" 
            horizAlign="center" 
            vertAlign="center" 
            visible="false" />
    </children>
</component>
