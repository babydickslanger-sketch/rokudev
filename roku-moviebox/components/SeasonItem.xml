<?xml version="1.0" encoding="utf-8" ?>
<component name="SeasonItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SeasonItem.brs" />
    <interface>
        <field id="itemContent" type="node" onChange="showContent" />
    </interface>
    <children>
        <Rectangle 
            id="seasonBackground" 
            width="180" 
            height="50" 
            color="0x333333" />
        <Label 
            id="seasonLabel" 
            text="" 
            font="font:MediumSystemFont" 
            color="0xFFFFFF" 
            translation="[90, 25]" 
            horizAlign="center" 
            vertAlign="center" />
    </children>
</component>
